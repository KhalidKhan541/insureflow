# ---------------------------------------------------------------------------
# InsureFlow — environment variables
# Copy this file to `.env.local` and fill in real values. Never commit
# `.env.local` — it is ignored by .gitignore.
# ---------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=InsureFlow
NODE_ENV=development

# InsureFlow core API (server-side only — never expose with NEXT_PUBLIC_)
INSUREFLOW_SECRET_KEY=sk_test_replace_me
INSUREFLOW_PUBLISHABLE_KEY=pk_test_replace_me
INSUREFLOW_WEBHOOK_SECRET=whsec_replace_me
INSUREFLOW_API_BASE_URL=https://api.insureflow.dev/v1

# Policy administration / core system (PAS)
PAS_API_URL=https://pas.insureflow.dev/api
PAS_API_KEY=replace_me

# Claims processing
CLAIMS_API_URL=https://claims.insureflow.dev/api
CLAIMS_API_KEY=replace_me

# Database (used by the API layer when it lands)
DATABASE_URL=postgres://user:password@localhost:5432/insureflow
DATABASE_URL_REPLICA=postgres://user:password@localhost:5432/insureflow

# Redis (rate limiting, job queues, quote caching)
REDIS_URL=redis://localhost:6379

# Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_openssl_rand_base64_32
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Analytics & observability
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Email (quotes, renewals, claims correspondence)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=InsureFlow <no-reply@insureflow.dev>

# Feature flags
NEXT_PUBLIC_FEATURE_AI_UNDERWRITING=true
NEXT_PUBLIC_FEATURE_FRAUD_DETECTION=true
NEXT_PUBLIC_FEATURE_SELF_SERVICE_CLAIMS=true
NEXT_PUBLIC_FEATURE_BROKER_PORTAL=false

# Mock data toggle — set to "false" once the real API is wired up
NEXT_PUBLIC_USE_MOCK_DATA=true
